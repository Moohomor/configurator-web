{
  "name": "configurator-scorm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:scorm": "npm run build && node scripts/package-scorm.mjs",
    "build:scorm:files": "npm run build && node scripts/package-scorm.mjs --lessons=files",
    "test": "playwright test"
  },
  "dependencies": {
    "three": "^0.170.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
